<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/naglowek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="#212529"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="Liczba kursów: 3" />

            <LinearLayout
                android:id="@+id/listaKursow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:labelFor="@+id/imieNazwisko"
                android:text="@string/etykieta_imie_nazwisko"
                android:textColor="#212529"
                android:textSize="17sp" />

            <EditText
                android:id="@+id/imieNazwisko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:autofillHints="name"
                android:background="@drawable/pole_formularza"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#212529"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:labelFor="@+id/numerKursu"
                android:text="@string/etykieta_numer_kursu"
                android:textColor="#212529"
                android:textSize="17sp" />

            <EditText
                android:id="@+id/numerKursu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:importantForAutofill="no"
                android:background="@drawable/pole_formularza"
                android:inputType="number"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#212529"
                android:textSize="17sp" />

            <Button
                android:id="@+id/przyciskZapisz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#0D6EFD"
                android:text="@string/zapisz_do_kursu"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:cornerRadius="6dp" />

            <TextView
                android:id="@+id/wynik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="14dp"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
